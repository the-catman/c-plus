// Structs are plain values. Functions that take them work on copies.
struct Point { int x = 0; int y = 0; };
struct Rect {
    string name = "rect";
    Point corner;
    int width;
    int height;
};

int main() {
    Rect r = {.name = "window", .width = 640, .height = 480};
    println("{}", r);
    println("area: {}", area(r));

    Rect moved = movedBy(r, 10, 20);
    println("original corner {}, moved corner {}", r.corner, moved.corner);

    Rect square;                // name and corner start from their defaults
    square.width = 3;
    square.height = square.width;
    println("{}", square);
    return 0;
}

long area(Rect r) {
    long w = r.width;           // int widens to long, so this multiply cannot overflow
    return w * r.height;
}

Rect movedBy(Rect r, int dx, int dy) {
    r.corner.x += dx;
    r.corner.y += dy;
    return r;                   // a changed copy; the caller's Rect is untouched
}
