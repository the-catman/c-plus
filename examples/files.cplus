// Pointers and C's file functions: FILE is a C type known only by name, so C+ holds a
// FILE* and passes it back to C. fgets fills a buffer from malloc, and string(p) copies
// the text out of it. Following a null pointer stops the program, so check for null.
extern "C" {
    struct FILE;
    FILE* tmpfile();
    int fputs(string text, FILE* f);
    void rewind(FILE* f);
    char* fgets(char* buffer, int size, FILE* f);
    int fclose(FILE* f);
    void* malloc(long size);
    void free(void* p);
}

// Counts the words in a line, walking it with a pointer as C code would.
int countWords(const char* text) {
    int words = 0;
    bool inWord = false;
    for (const char* p = text; *p != '\0'; p++) {
        bool space = isspace(*p);
        if (!space && !inWord) words++;
        inWord = !space;
    }
    return words;
}

int main() {
    FILE* f = tmpfile();
    if (f == null) {
        println("could not open a temporary file");
        return 1;
    }
    for (string line : vector<string>{"the quick brown fox", "jumps over", "the lazy dog"})
        fputs(line + "\n", f);
    rewind(f);

    const int size = 256;
    char* buffer = (char*)malloc(size);
    int lines = 0, words = 0;
    while (fgets(buffer, size, f) != null) {
        string line = string(buffer);
        lines++;
        words += countWords(buffer);
        print("{}: {}", lines, line);
    }
    println("{} lines, {} words", lines, words);

    free(buffer);
    fclose(f);
    return 0;
}
