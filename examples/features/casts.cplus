// Casts are written as in C++. A smaller integer keeps the lowest bits; checked code stops the program instead.
int main() {
    double d = 3.9;
    println("{} {} {}", int(d), static_cast<int>(d), (int)d);
    // expect: 3 3 3
    println("{}", char(65));
    // expect: A
    int x = 7;
    void* p = &x;
    int* back = static_cast<int*>(p);
    println("{}", *back);
    // expect: 7
    long tooBig = 3000000000;
    println("{} {}", int(tooBig), int(1e10));
    // expect: -1294967296 2147483647
    int small = checked(int(tooBig));
    println("never printed {}", small);
    return 0;
}
// trap: 3000000000
