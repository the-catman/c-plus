// `*` belongs to each name, so a declaration has to say it for each of them. `const` can go on either side, as in C++.
int main() {
    int a = 1;
    int b = 2;
    int* p = &a, * q = &b;
    const int* readOnly = &a;
    int* const fixed = &b;
    *fixed = 3;
    println("{} {} {}", *p + *q, *readOnly, b);
    // expect: 4 1 3
    return 0;
}
