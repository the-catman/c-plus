// A C header declares what the program uses from it: functions, structs and constants.
import <stdio.h>;
import <stdlib.h>;
import <time.h>;

int main() {
    FILE* f = tmpfile();
    if (f) {
        println("{}", fputs("saved", f) >= 0);
        // expect: true
        fclose(f);
    }
    long now = 86400;
    tm t = {};
    gmtime_r(&now, &t);
    println("{} {}", t.tm_year, t.tm_mday);
    // expect: 70 2
    div_t d = div(17, 5);
    println("{} {}", d.quot, d.rem);
    // expect: 3 2
    println("{}", EOF);
    // expect: -1
    return 0;
}
