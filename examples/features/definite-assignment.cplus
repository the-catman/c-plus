// A variable can start without a value, if every path gives it one before it is read. The compiler checks.
struct Point { int x; int y; };

int main() {
    int n;
    if (2 > 1) n = 1;
    else n = 2;
    println("{}", n);
    // expect: 1
    Point p;
    p.x = 3;
    p.y = 4;
    println("{}", p);
    // expect: {x: 3, y: 4}
    return 0;
}
