// `const T&` reads a value where it is, without copying it, and `T&` can change it, as in C++.
struct Point {
    int x = 0;
    int y = 0;
};

bool same(const Point& a, const Point& b) { return a.x == b.x && a.y == b.y; }

void bump(int& n) { n += 1; }

// A function that returns `T&` returns the place, which its caller can change.
struct Grid {
    vector<int> cells = {0, 0, 0};
    int& at(int i) { return cells[i]; }
};

int total(const vector<int>& v) {
    int sum = 0;
    for (const auto& x : v) sum += x;  // each element in place
    return sum;
}

int main() {
    vector<int> scores = {3, 4, 5};
    println("{}", total(scores));
    // expect: 12
    Point p = Point{1, 2};
    println("{}", same(p, Point{1, 2}));
    // expect: true
    const Point& here = p;  // names p itself
    p.x = 7;
    println("{}", here.x);
    // expect: 7
    int count = 1;
    bump(count);  // changes count itself
    println("{}", count);
    // expect: 2
    const int& n = 3 + 4;  // a value that is not a place lives as long as the reference
    println("{}", n);
    // expect: 7
    for (auto& s : scores) s *= 10;  // each element itself
    bump(scores[0]);
    auto& last = scores[2];
    scores.push_back(60);  // `last` is still scores[2], wherever the elements are now
    last += 1;
    println("{}", scores);
    // expect: [31, 40, 51, 60]
    Grid grid = Grid();
    grid.at(1) = 5;
    grid.at(1) += 1;
    bump(grid.at(2));
    println("{}", grid.cells);
    // expect: [0, 6, 1]
    return 0;
}
