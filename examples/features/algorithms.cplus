// sort and the other functions of <algorithm> take the vector itself, and a lambda where C++ takes a function.
struct Person {
    string name;
    int age;
};

int main() {
    vector<int> v = {5, 3, 8, 1};
    sort(v);
    println("{}", v);
    // expect: [1, 3, 5, 8]
    sort(v, [](int a, int b) { return a > b; });
    println("{}", v);
    // expect: [8, 5, 3, 1]
    vector<Person> people = {{"Ada", 36}, {"Linus", 21}, {"Grace", 36}};
    stable_sort(people, [](const Person& a, const Person& b) { return a.age < b.age; });
    println("{} {} {}", people[0].name, people[1].name, people[2].name);
    // expect: Linus Ada Grace
    println("{}", count_if(people, [](const auto& p) { return p.age >= 30; }));
    // expect: 2
    if (auto at = index_of(v, 3)) println("3 is at {}", at);
    // expect: 3 is at 2
    long removed = erase_if(v, [](int x) { return x % 2 == 0; });
    println("{} {}", removed, v);
    // expect: 1 [5, 3, 1]
    println("{} {} {}", min(v), max(v), accumulate(v, 0));
    // expect: 1 5 9
    vector<double> d = {2.5, 0.0 / 0.0, -1.0};
    sort(d);
    println("{}", d);
    // expect: [-1, 2.5, nan]
    string word = "banana";
    sort(word);
    println("{}", word);
    // expect: aaabnn
    return 0;
}
