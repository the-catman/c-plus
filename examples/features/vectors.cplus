// A vector is a value, copied cheaply, whose indexes are always checked.
int main() {
    vector<int> v = {1, 2, 3};
    vector<int> copy = v;
    v.push_back(4);
    v[0] = 10;
    println("{} {}", v, copy);
    // expect: [10, 2, 3, 4] [1, 2, 3]
    println("{} {} {} {}", v.size(), v.front(), v.back(), v.empty());
    // expect: 4 10 4 false
    v.pop_back();
    auto zeros = vector<int>(2);
    auto sevens = vector<int>(2, 7);
    println("{} {} {}", v.size(), zeros, sevens);
    // expect: 3 [0, 0] [7, 7]
    println("{}", v[9]);
    return 0;
}
// trap: 9
