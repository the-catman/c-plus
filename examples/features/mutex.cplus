// A class reference is shared between threads, so what changes its fields needs a Mutex.
class Account {
public:
    long balance = 0;
    Mutex lock = Mutex();
    void add(long n) {
        LockGuard guard = LockGuard(lock);
        balance += n;
    }
};

void addMany(Account a) { for (int i = 0; i < 1000; i++) a.add(1); }

int main() {
    Account account = Account();
    vector<Task<void>> tasks;
    for (int i = 0; i < 4; i++) tasks.push_back(spawn addMany(account));
    for (auto t : tasks) t.wait();
    println("{}", account.balance);
    // expect: 4000
    return 0;
}
