// The last parameters can have default values, which a call that leaves them out gets, as in C++.
string greet(string name, string greeting = "hello", int times = 1) {
    string out = "";
    for (int i = 0; i < times; ++i) out += greeting + " " + name + ";";
    return out;
}

class Box {
public:
    int w = 0;
    int h = 0;
    Box(int width, int height = 10) : w(width), h(height) {}
    int area(int extra = 0) const { return w * h + extra; }
};

int main() {
    println("{}", greet("ada"));
    // expect: hello ada;
    println("{}", greet("bob", "hi"));
    // expect: hi bob;
    println("{}", greet("cy", "hey", 2));
    // expect: hey cy;hey cy;
    Box b = Box(2);  // its height is 10
    println("{} {}", b.area(), b.area(5));
    // expect: 20 25
    return 0;
}
