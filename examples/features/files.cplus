// `import fs;` reads and writes files: all of one with `fs::read` and `fs::write`, or a line at a time with `fs::open`.
// Each can fail with an `fs::Error`.
import fs;

int main() throws {
    try fs::write("notes.txt", "first\r\nsecond\n");
    try fs::append("notes.txt", "third\n");

    // The bytes as they are: line endings are not changed.
    string text = try fs::read("notes.txt");
    println("{} bytes, {}", text.size(), text.starts_with("first\r\n"));
    // expect: 20 bytes, true

    // readLine() takes the "\n" or "\r\n" off, and is null at the end.
    fs::File in = try fs::open("notes.txt", "r");
    while (auto line = try in.readLine()) println("[{}]", line);
    try in.close();
    // expect: [first]
    // expect: [second]
    // expect: [third]

    try fs::create_directories("old/notes");
    try fs::rename("notes.txt", "old/notes/kept.txt");
    println("{} {}", fs::exists("notes.txt"), try fs::list("old/notes"));
    // expect: false ["kept.txt"]

    try {
        string missing = try fs::read("missing.txt");
        println("{}", missing);
    } catch (fs::Error e) {
        println("{} {}", e.kind, e.path);
        println("{}", e.what());
    }
    // expect: not-found missing.txt
    // expect: could not read "missing.txt": there is no such file

    try fs::remove("old/notes/kept.txt");
    try fs::remove("old/notes");
    try fs::remove("old");
    return 0;
}
