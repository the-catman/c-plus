// `import fs;` reads all of a file with `fs::read`, which can fail with an `fs::Error`. fs cannot write files yet, so C's
// functions make the one this reads.
import fs;

extern "C" {
    struct FILE;
    FILE* fopen(string path, string mode);
    int fputs(string text, FILE* f);
    int fclose(FILE* f);
}

int main() throws {
    FILE* f = fopen("notes.txt", "w");
    fputs("first\r\nsecond\n", f);
    fclose(f);

    // The bytes as they are: line endings are not changed.
    string text = try fs::read("notes.txt");
    println("{} bytes, {}", text.size(), text.starts_with("first\r\n"));
    // expect: 14 bytes, true

    try {
        string missing = try fs::read("missing.txt");
        println("{}", missing);
    } catch (fs::Error e) {
        println("{} {}", e.kind, e.path);
        println("{}", e.what());
    }
    // expect: not-found missing.txt
    // expect: could not read "missing.txt": there is no such file
    return 0;
}
