// An enum class is a list of names. An enumerator is written with its enum, nothing turns into a number by itself, and
// Color(n) stops the program unless n is the value of an enumerator.
const int LIMIT = 10;

enum class Color { Red, Green, Blue };
enum class Status : long { Ok = 200, NotFound = 404, Far = 5000000000 };
enum class Flags { Small = 1, Big = 1 << 20, Last = LIMIT - 1 };

const Color FAVORITE = Color::Green;

struct Pixel {
    Color color = Color::Blue;
    int x = 0;
};

int main() {
    Color c = Color::Green;
    if (c != Color::Red) println("{}", c);
    // expect: Green
    int n = int(c);
    Color next = Color(int(c) + 1);
    println("{} {} {}", n, next, static_cast<Color>(0));
    // expect: 1 Blue Red
    println("{} {}", c < next, c == FAVORITE);
    // expect: true true
    println("{} {}", long(Status::Far), Status::NotFound);
    // expect: 5000000000 NotFound
    println("{} {}", int(Flags::Big), int(Flags::Last));
    // expect: 1048576 9
    Pixel p = {};
    println("{}", p);
    // expect: {color: Blue, x: 0}
    hashmap<Color, int> votes;
    votes[Color::Blue] += 2;
    votes[Color::Red] += 1;
    println("{}", votes);
    // expect: {Blue: 2, Red: 1}
    println("{} {}", format("{}", c), to_string(int(c)));
    // expect: Green 1
    return 0;
}
