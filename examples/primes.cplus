// Counts prime numbers on several threads at once, and adds up what each one found.
// cplus run examples/primes.cplus -- 2000000 8

bool isPrime(long n) {
    if (n < 2) return false;
    for (long d = 2; d * d <= n; d++)
        if (n % d == 0) return false;
    return true;
}

// Runs on a thread. It gets its numbers as arguments and hands back its result, so it shares nothing with the others.
long countPrimes(long from, long to) {
    long found = 0;
    for (long n = from; n < to; n++)
        if (isPrime(n)) found++;
    return found;
}

extern "C" long atol(string text);

int main(int argc, char** argv) {
    long limit = argc > 1 ? atol(string(argv[1])) : 1000000;
    long threads = argc > 2 ? atol(string(argv[2])) : 4;

    vector<Task<long>> tasks;
    long step = limit / threads;
    for (long i = 0; i < threads; i++) {
        long from = i * step;
        long to = i == threads - 1 ? limit : from + step;
        tasks.push_back(spawn countPrimes(from, to));
    }

    long total = 0;
    for (auto t : tasks) total += t.wait();
    println("{} primes below {}, on {} threads", total, limit, threads);
    return 0;
}
