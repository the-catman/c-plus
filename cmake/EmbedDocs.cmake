# Writes what `cplus explain` shows into a C++ file, so the compiler has it wherever it is run from.
# Called with -DOUT=<file> -DROOT=<the repo>. Each text goes in a raw string in pieces, as a compiler can limit how long one literal is.
function(cplus_append_text out text)
  string(LENGTH "${text}" total)
  set(at 0)
  while(at LESS total)
    string(SUBSTRING "${text}" ${at} 8000 piece)
    file(APPEND "${out}" "R\"cplusdoc(${piece})cplusdoc\"\n")
    math(EXPR at "${at} + 8000")
  endwhile()
  if(total EQUAL 0)
    file(APPEND "${out}" "\"\"\n")
  endif()
endfunction()

file(WRITE "${OUT}" "// Written by cmake/EmbedDocs.cmake.\n#include \"Explain.h\"\nnamespace cplus {\nconst char* const kEmbeddedSpec =\n")
file(READ "${ROOT}/docs/SPEC.md" spec)
cplus_append_text("${OUT}" "${spec}")
file(APPEND "${OUT}" ";\nconst char* const kEmbeddedCheatSheet =\n")
file(READ "${ROOT}/docs/CHEATSHEET.md" sheet)
cplus_append_text("${OUT}" "${sheet}")
file(APPEND "${OUT}" ";\nconst EmbeddedExample kEmbeddedExamples[] = {\n")
file(GLOB examples "${ROOT}/examples/features/*.cplus")
list(SORT examples)
foreach(path ${examples})
  get_filename_component(name "${path}" NAME_WE)
  file(READ "${path}" text)
  file(APPEND "${OUT}" "{\"${name}\",\n")
  cplus_append_text("${OUT}" "${text}")
  file(APPEND "${OUT}" "},\n")
endforeach()
file(APPEND "${OUT}" "{nullptr, nullptr}};\n}  // namespace cplus\n")
