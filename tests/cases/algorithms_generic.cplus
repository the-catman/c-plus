// The algorithms in generics, where the element type is a parameter, and a function of the program named sort, which
// takes the place of the built-in one.
struct Score {
    string who;
    int points;
};

template<Comparable T> T median(vector<T> v) {
    sort(v);
    return v[v.size() / 2];
}
template<typename T> void sortBy(vector<T>& v, function<bool(T, T)> less) { stable_sort(v, less); }
template<typename T, typename K> vector<T> byKey(vector<T> v, function<K(T)> key) {
    sort(v, [&](const T& a, const T& b) { return key(a) < key(b); });
    return v;
}
template<typename T> long distinct(vector<T> v) {
    long n = 0;
    for (long i = 0; i < v.size(); i++)
        if (index_of(v, v[i]) == i) n++;
    return n;
}

int main() {
    println("{} {} {}", median(vector<int>{5, 1, 4}), median(vector<string>{"b", "c", "a"}), median(vector<double>{0.5, 0.25, 1.0}));
    // expect: 4 b 0.5
    vector<Score> s = {{"a", 3}, {"b", 1}, {"c", 3}, {"d", 2}};
    sortBy(s, [](Score x, Score y) { return x.points > y.points; });
    for (auto& e : s) print("{}", e.who);
    println();
    // expect: acdb
    auto named = byKey<Score, string>(s, [](Score x) { return x.who; });
    println("{} {}", named[0].who, named[3].who);
    // expect: a d
    println("{} {}", distinct(vector<int>{1, 2, 1, 3, 2}), distinct(vector<string>{"x", "x"}));
    // expect: 3 1
    return 0;
}
