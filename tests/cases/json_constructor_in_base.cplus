// A field that a class's constructor sets is not required from JSON, even when the field is in its base class.
import json;

class Base {
public:
    int id;
};
class SetsBaseField : public Base {
public:
    int v = 0;
    SetsBaseField() { id = 7; }
};

int main() throws {
    SetsBaseField a = try json::parse<SetsBaseField>("{}");
    println("{} {}", a.id, a.v);
    // expect: 7 0
    return 0;
}
