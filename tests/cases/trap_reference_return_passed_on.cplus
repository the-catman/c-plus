// A place that one `T&` function returns, and another passes on, is checked where the statement that used it ends: here a
// key was added to the hashmap meanwhile, which grew it.
struct Counts {
    hashmap<string, int> m;
    int& of(string k) { return m[k]; }
    int& again(string k) { return of(k); }
};
void set(int& e, int n) { e = n; }
int main() {
    Counts c = Counts();
    c.again("a") = 1;
    c.again("a") += c.of("b") + 1;
    println("{}", c.m);  // expect: {"a": 2, "b": 0}
    set(c.again("a"), c.of("c"));
    println("{}", c.m);
    return 0;
}
// trap: 'again' returned a place in a vector, string or hashmap that was grown, shrunk, copied, replaced or freed while the place was in use, which would lose what was written through it
// trap: trap_reference_return_passed_on.cplus:14:11
