// Writing array types and C-style arrays.
void takes(int values[3]) {}
void takesAny(int values[]) {}

struct Row {
    int cells[4];
};

int main() {
    int n = 3;
    array<> a1;
    array<void, 3> a2;
    array<auto, 3> a3;
    array<int> a4;
    array<int, n> a5;
    array<int, -1> a6;
    array<int, 2.5> a7;
    array<int, 2 * 3> a8;
    array<int, 2, 3> a9;
    int c1[5];
    int c2[] = {1, 2};
    int c3[n];
    auto b1 = array<int, 3>;
    auto b2 = array<int, 3>(1, 2);
    array<Missing, 3> b3;
    std::array<int, 3> b4;
    array<int, 3> b5{1, 2};
    array<int, 3> b6(1, 2);
    return 0;
}
