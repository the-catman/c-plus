// What `std::make_unique` and `std::make_shared` are told, the same as without `std::`, and other parser help.
template <typename T>
class Box {
public:
    T x;
    Box(T v) throws { x = v; }
    // error: `template <typename T> Box<T> make(int x) throws { ...; return Box<T>(x); }`
};
struct F { int* a, * const b; };
// error: declare it on its own line, without `const`: `int* b;`. A field cannot be const yet
int main() {
    string s = "a";
    string::size_type n = s.size();
    // error: write `long`, or `auto`: sizes and positions in a string are a `long`
    auto b = std::make_unique<int[]>(10);
    // error: write `vector<int>(count, value)`: a vector is a value that needs no pointer
    auto c = std::make_shared<int>(5);
    // error: write the value itself, as in `int(3)`: a value needs no pointer
    auto d = std::make_unique(3);
    // error: write `unique<Node>(...)`, which builds a new Node
    return 0;
}
