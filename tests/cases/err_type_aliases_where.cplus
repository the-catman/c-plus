// A type alias is written at the top of a file, and `typedef` is written as one.
class Holder {
    using Inner = int;
};
void f() {
    using Local = int;
}
typedef unsigned long Big;
typedef int myint;
typedef void (*callback)(int);
int main() { return 0; }
