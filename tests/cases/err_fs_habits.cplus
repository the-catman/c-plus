// Reading a file as C, C++, JavaScript and Rust do, and what the compiler says to write instead. What fs has later is
// reported as planned.
import fs;

void streams() { std::ifstream file("notes.txt"); }
void outStreams() { std::ofstream file("notes.txt"); }
void bareStream() { ifstream file("notes.txt"); }
void bareOutStream() { ofstream file("notes.txt"); }
void cFile() { FILE* f = null; }
void rust() { string text = std::fs::read_to_string("notes.txt"); }
void filesystem() { bool b = std::filesystem::exists("notes.txt"); }

int main() throws {
    string a = fs.readFileSync("notes.txt");
    auto b = fs::readFile("notes.txt");
    auto c = fs::writeFile("notes.txt", "x");
    fs::write("notes.txt", "x");
    fs::append("notes.txt", "x");
    bool d = fs::exists("notes.txt");
    fs::remove("notes.txt");
    auto e = fs::list(".");
    auto f = fs::open("notes.txt");
    string g = fs::read_to_string("notes.txt");
    string h = fs::readAll("notes.txt");
    string i = fs::nothing("notes.txt");
    string j = readFileSync("notes.txt");
    string k = read_to_string("notes.txt");
    string l = readFile("notes.txt");
    auto m = fopen("notes.txt", "r");
    string n = fs::read("notes.txt");
    return 0;
}
