struct Point { int x; int y; };
struct Node { int value; Node next; };
struct Twice { int a; int a; };

int main() {
    Point p = {1, 2};
    println("{}", p.z);
    println("{}", p.xx);
    Point many = {1, 2, 3};
    Point mixed = {1, .y = 2};
    Point wrong = {.q = 1};
    Point repeat = {.x = 1, .x = 2};
    auto bare = {1, 2};
    int number = {5};
    int n = 3;
    println("{}", n.x);
    bool same = p < p;
    bool other = p == 1;
    Point bad = {"one", 2};
    Point big = Point(1, 2, 3);
    println("{}", Point);
    return 0;
}
