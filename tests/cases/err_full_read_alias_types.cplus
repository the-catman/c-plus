// What a C++ type of an alias is in C+, or that it has none.
class Node { };
using M = std::unordered_map<std::string, int>;
// error: write the type itself, `hashmap<string, int>`, wherever `M` is used
using O = std::optional<int>;
// error: write the type itself, `int?`, wherever `O` is used
using S = std::shared_ptr<Node>;
// error: write the type itself, `Node`, wherever `S` is used
using U = std::unique_ptr<Node>;
// error: write the type itself, `unique<Node>`, wherever `U` is used
using PR = std::pair<int, int>;
// error: write the type itself wherever `PR` is used, as C+ writes it: `cplus explain cheatsheet` shows what takes the place of each C++ type
using G = ::std::string;
// error: write the type itself, `string`, wherever `G` is used
using V = std::vector<std::vector<int>>;
// error: write the type itself, `vector<vector<int>>`, wherever `V` is used
int main() { return 0; }
