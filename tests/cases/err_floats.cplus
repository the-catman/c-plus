// Mistakes with floating-point numbers, casts and math functions.
struct Box {
    float size;
};

double half(double x) { return x / 2; }

int main() {
    double d = 2.5;
    float f = 1.5f;
    int i = d;
    long l = f;
    float g = d;
    float tooBig = 1e39;
    Box b = {d};
    int h = half(4);
    int r = sqrt(4);
    float q = sqrt(d);
    double m = d % 2;
    double bits = d & 1;
    double flip = ~d;
    double moved = d << 1;
    f %= 2;
    println("{:.2f}", i);
    println("{:.2f}", "text");
    println("{:x}", d);
    println("{:.f}", d);
    string s = string(d);
    string t = static_cast<string>(i);
    int n = int("42");
    double e = double("2.5");
    int? maybe = 4;
    int fromOptional = int(maybe);
    vector<int> v = {1};
    long fromVector = (long)v;
    double w = sqrt("4");
    double x = pow(2);
    double y = min(1, 2, 3);
    int k = abs(true);
    double z = sqrt();
    double u = fmod(maybe, 2);
    return 0;
}
