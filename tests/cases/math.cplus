// Math functions, with the names of C++'s <cmath>. They take any numbers; a float in
// gives a float out, as with C++'s overloads.
double log(string message) {  // a function of the program takes the place of a built-in
    println("log: {}", message);
    return 0;
}

int main() {
    println("{} {} {} {}", sqrt(16), sqrt(2.0), pow(2, 10), pow(2.0, 0.5));
    // expect: 4 1.4142135623730951 1024 1.4142135623730951
    println("{:.6f} {} {} {}", cbrt(27), exp(0), exp2(10), hypot(3, 4));
    // expect: 3.000000 1 1024 5
    println("{} {} {}", log2(1024), log10(0.001), fmod(7.5, 2));
    // expect: 10 -3 1.5
    log("a function named log");
    // expect: log: a function named log

    // Rounding. round() takes halves away from zero, as in C.
    println("{} {} {} {}", floor(-2.5), ceil(-2.5), round(-2.5), trunc(-2.5));
    // expect: -3 -2 -3 -2
    println("{} {} {}", round(0.5), round(1.5), round(2.5));
    // expect: 1 2 3

    // Trigonometry.
    double pi = acos(-1);
    println("{} {} {:.6f} {:.6f}", pi, atan2(1, 1) * 4, sin(pi / 6), cos(pi / 3));
    // expect: 3.141592653589793 3.141592653589793 0.500000 0.500000
    println("{:.4f} {:.4f} {} {}", tan(pi / 4), asin(1), atan(0), tanh(0));
    // expect: 1.0000 1.5708 0 0
    println("{} {} {}", sinh(0), cosh(0), fabs(-3.5));
    // expect: 0 1 3.5

    // abs, min and max keep the type of their arguments.
    int n = -7;
    println("{} {} {} {}", abs(n), abs(-2.5), abs(-9000000000L), abs(0));
    // expect: 7 2.5 9000000000 0
    println("{} {} {} {}", min(3, 8), max(3, 8), min(2.5, -1), max(1, 9000000000L));
    // expect: 3 8 -1 9000000000
    int smallest = min(n, 0);
    long largest = max(n, 5L);
    println("{} {}", smallest, largest);
    // expect: -7 5

    // Floats stay floats.
    float f = 2;
    float root = sqrt(f);
    float bigger = max(f, 2.5f);
    println("{} {} {}", root, bigger, pow(f, 0.5f));
    // expect: 1.4142135 2.5 1.4142135

    // Testing for NaN and infinities.
    double zero = 0;
    println("{} {} {} {}", isnan(zero / zero), isnan(1.0), isinf(1 / zero), isinf(-1 / zero));
    // expect: true false true true
    println("{} {} {}", isfinite(1e308), isfinite(1e308 * 10), isfinite(zero / zero));
    // expect: true false false
    println("{} {}", isnan(sqrt(-1)), isnan(pow(-8, 1.0 / 3)));
    // expect: true true
    return 0;
}
