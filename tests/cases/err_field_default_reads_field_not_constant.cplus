// A field's default sees the field with that name, not a constant of the file, so this is
// the usual error about reading another field.
const int a = 5;

struct T {
    int a = 1;
    int b = a;
};

int main() {
    T t;
    println("{}", t);
    return 0;
}
// error: a field's default cannot read other fields
