// Options that do not suit the value they print, which the compiler checks.
struct Point { int x = 0; };
int main() {
    double d = 1.5;
    int n = 1;
    int? o = 1;
    double? od = 1.5;
    char c = 'a';
    bool b = true;
    string s = "a";
    vector<int> v = {1};
    Point p = Point{};
    println("{:x}", d);
    println("{:d}", d);
    println("{:x}", o);
    println("{:x}", v);
    println("{:x}", s);
    println("{:c}", n);
    println("{:s}", n);
    println("{:s}", c);
    println("{:?}", n);
    println("{:?}", p);
    println("{:p}", n);
    println("{:.3}", n);
    println("{:.3}", b);
    println("{:.3?}", s);
    println("{:+}", s);
    println("{:+}", c);
    println("{:+}", od);
    println("{:#}", n);
    println("{:#}", s);
    println("{:#o}", n);
    println("{:#.2f}", d);
    println("{:08}", s);
    println("{:<08}", n);
    println("{:{}}", n, d);
    println("{:.{}f}", d, c);
    println("{:{}}", n, o);
    println("{:{}}", n, s);
    println("{:e}", n);
    return 0;
}
