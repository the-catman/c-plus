class User {
    string password;
public:
    string name;
    int age;
    User(string n) : name(n) {}
    int getAge() const { age = 3; return age; }
    void change() { age = 1; }
    int peek() const { change(); return 0; }
private:
    void secret() {}
};

class Node {
public:
    int value;
    Node next;
    Node(int v) : value(v) {}
};

class Holder {
public:
    User user;
};

struct Counter {
    int n;
    int doubled = n * 2;
    void bump() { n += 1; }
};

int main() {
    User a = User("a", 2);
    User b = User("b");
    println("{}", b.password);
    b.secret();
    User none;
    println("{}", none.name);
    Holder h = {};
    const Counter c = {1};
    c.bump();
    println("{}", b == b);
    println("{}", b.nam);
    println("{}", b.getAge);
    b.age();
    b.fly();
    User d = User{.name = "d"};
    println("{}", this);
    return 0;
}
