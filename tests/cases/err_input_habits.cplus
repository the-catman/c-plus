// Reading input as C and C++ do, and what the compiler says to write instead.
void lines() {
    string line;
    std::getline(std::cin, line);
}
void number() {
    int n = 0;
    std::cin >> n;
}
void bareGetline() {
    string line;
    getline(cin, line);
}
void scanning() {
    int n = 0;
    scanf("%d", &n);
}
int main() { return 0; }
