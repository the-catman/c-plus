// Functions of one name that cannot be told apart, and calls that fit none of them or more than one as well.
struct Point {
    int x = 0;
    int y = 0;
};

string show(int a, long b) { return "a"; }
string show(long a, int b) { return "b"; }
string show(Point p) { return "point"; }
string show(vector<int> v) { return "vector"; }

void take(string s) {}
void take(const string& s) {}

int same(int n) { return n; }
long same(int m) { return 1; }

void twice(int n) {}
void twice(int m) {}

extern "C" int abs(int n);
int abs(long n) { return 0; }

void bump(int& n) { n += 1; }
void bump(long& n) { n += 1; }

int main() {
    println("{}", show(1, 2));
    println("{}", show({1, 2}));
    println("{}", show("text"));
    println("{}", show(1, 2, 3));
    println("{}", show(undefinedName));
    bump(5);
    return 0;
}

int main(int argc, char** argv) { return 0; }
