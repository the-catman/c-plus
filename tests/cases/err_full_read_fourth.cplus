// The fourth reading: aliases of C++ types C+ has no form for, or a form with rules of its own, `const` kept,
// and `->` through a pointer to a container.
class Node { };
struct Pt { int x = 0; };
using A1 = std::optional<int*>;
// error: write `using A1 = int*;`
using A2 = std::optional<std::optional<int>>;
// error: write `using A2 = int?;`
using A3 = std::unique_ptr<int>;
// error: write `unique<Node>`, which works like std::unique_ptr, but is never empty
using A5 = std::shared_ptr<int>;
// error: a class variable is already a counted reference: `class Node {...};`, then `Node n = Node();`
using A6 = std::queue<int>;
// error: use a `vector<T>` or a `hashmap<K, V>` for now: `cplus explain hashmap` says what they do
using A7 = std::mutex;
// error: write `using A7 = Mutex;`
using A8 = intptr_t;
// error: write `using A8 = long;`
using B2 = const int*;
using B3 = std::vector<const int*>;
// error: write `using B3 = vector<const int*>;`
void f(vector<Pt*>* pp, string path) {
    int c = (*pp)->x;
    // error: only a pointer is followed with '->', and '*pp' holds 'Pt*': write `(*pp)[i]->x`
}
int main() { return 0; }
