int noexceptFunction() noexcept { return 1; }
int oldThrow() throw() { return 1; }
class Order {
    int f() throws const { return 1; }
};
void aloneCatch() {
    catch (Error e) {}
}
void noCatch() {
    try {
        println("x");
    }
    println("y");
}
void javascript() {
    try {
        println("x");
    } catch (e) {
    }
}
void noParens() {
    try {
        println("x");
    } catch {
    }
}
void reference() {
    try {
        println("x");
    } catch (const Error& e) {
    }
}
void finallyToo() {
    try {
        println("x");
    } catch (Error e) {
    } finally {
    }
}
void asValue() {
    int x = try { 1; };
}
int inExpression(bool b) {
    return b ? 1 : throw Error("x");
}
int main() {
    return 0;
}
// error: C+ has no noexcept
// error: a function that can fail is marked `throws`
// error: `const` comes before `throws`
// error: a catch comes right after a try block
// error: a try block needs at least one catch
// error: a catch says the type of error it takes
// error: write `catch (Error e)`
// error: a catch says what it takes
// error: C+ has no finally
// error: a try block is a statement, so it has no value
// error: `throw` is a statement, so it cannot be part of an expression
