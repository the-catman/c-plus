import json;

class Node {
public:
    string name = "a";
    Node? next;
};

int main() {
    Node a = Node();
    Node b = Node();
    a.next = b;
    b.next = a;
    println("before");
    println("{}", json::stringify(a));
    a.next = null;
    return 0;
}
// expect: before
// trap: an object refers to itself, directly or through others, so it cannot be written as JSON
