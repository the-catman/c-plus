// The modes fs::open takes are "r", "w" and "a". A literal that is not one of them is an error, with the one that was
// likely meant. What Node, Python, Rust and std::filesystem call what fs has gets fs's name.
import fs;

int main() throws {
    fs::File a = try fs::open("a.txt", "rb");
    fs::File b = try fs::open("a.txt", "wt");
    fs::File c = try fs::open("a.txt", "a+");
    fs::File d = try fs::open("a.txt", "x");
    fs::File e = try fs::open("a.txt", "");
    fs::File f = try fs::open("a.txt", 'r');
    fs::File g = try fs::open("a.txt");
    try fs::writeFileSync("a.txt", "x");
    try fs::appendFile("a.txt", "x");
    bool h = fs::existsSync("a.txt");
    try fs::mkdir("place");
    try fs::makedirs("place/inner");
    try fs::create_dir_all("place/inner");
    auto i = try fs::readdir(".");
    auto j = try fs::listdir(".");
    auto k = try fs::directory_iterator(".");
    try fs::unlink("a.txt");
    try fs::rmdir("place");
    try fs::renameSync("a.txt", "b.txt");
    bool l = fs::isdir("place");
    long m = try fs::getsize("a.txt");
    auto n = try fs::openSync("a.txt", "r");
    try fs::write_all("a.txt", "x");
    return 0;
}
// error: fs::open() opens a file with the mode "r", "w" or "a", but this is "rb"
// error: write "r": a file is always read and written as the bytes it has, so there is no "b" or "t"
// error: spec: docs/SPEC.md#files
// error: fs::open() opens a file with the mode "r", "w" or "a", but this is "wt"
// error: write "w": a file is always read and written as the bytes it has
// error: fs::open() opens a file with the mode "r", "w" or "a", but this is "a+"
// error: read it with one `fs::open(path, "r")`, and write it with another, with "w" or "a": a file is not open for both
// error: fs::open() opens a file with the mode "r", "w" or "a", but this is "x"
// error: write "r" to read it, "w" to write it from its start, or "a" to add to its end
// error: fs::open() opens a file with the mode "r", "w" or "a", but this is ""
