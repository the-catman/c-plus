// Mistakes with chars, and what to write instead.
string name() { return "x"; }

int main() {
    const string k = "abc";
    k[0] = 'x';
    name()[0] = 'y';
    char c = 65;
    char d = "a";
    char e = "ab";
    string s = c;
    bool b = c;
    if (c) println("x");
    while (!c) {}
    c *= 2;
    c += 1.5;
    c = c + 1;
    println("{}", s == 'a');
    println("{}", to_string(c));
    println("{}", isdigit(5));
    println("{}", isdigit("5"));
    println("{}", toupper());
    println("{:.2f}", c);
    char f = char("a");
    string g = string(c);
    string h = string(3, "ab");
    string i = string(1, 2, 3);
    println("{}", s[c]);
    s.push_back("ab");
    s.at(0);
    double x = c % 2.5;
    return 0;
}
// error: 'k' is const, so its chars cannot be assigned to
