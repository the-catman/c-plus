struct Point {
    int x;
    int y;
};

class User {
public:
    string name;
    User(string n) : name(n) {}
};

extern "C" {
    int area(Point p);
    void keep(User u);
    long total(vector<int> values);
    int maybe(int? n);
    Point origin();
    int? find(string key);
    int empty(void x);
    int main();
    void cplus_trap();
    int println(int x);
    int abs(int);
    void srand(int seed);
}

int abs(int n) { return n < 0 ? -n : n; }

int main() {
    srand("seed");
    srand(1, 2);
    int n = srand(3);
    return 0;
}
