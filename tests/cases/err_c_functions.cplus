struct Point {
    int x;
    int y;
};

class User {
public:
    string name;
    User(string n) : name(n) {}
};

struct Named {
    string name;
};

struct Outer {
    Named inner;
};

extern "C" {
    int area(Point p);
    Point origin();
    int label(Named n);
    Outer deep();
    void hold(User* u);
    void texts(string* s);
    void holdsNamed(Named* n);
    void keep(User u);
    long total(vector<int> values);
    int maybe(int? n);
    int? find(string key);
    int empty(void x);
    int main();
    void cplus_trap();
    int println(int x);
    int abs(int);
    void srand(int seed);
}

int abs(int n) { return n < 0 ? -n : n; }

int main() {
    srand("seed");
    srand(1, 2);
    int n = srand(3);
    return 0;
}
