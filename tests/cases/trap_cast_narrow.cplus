// A long that does not fit in an int stops the program instead of wrapping around.
int main() {
    long big = 3000000000L;
    println("{}", int(big - 1000000000L));
    int n = int(big);
    println("{}", n);
    return 0;
}
// expect: 2000000000
// trap: int(x) was given 3000000000, which does not fit in an int (from -2147483648 to 2147483647)
// trap: trap_cast_narrow.cplus:5:13
