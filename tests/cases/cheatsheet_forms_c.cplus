// The cheat sheet's forms of C functions. See cheatsheet_forms.
extern "C" struct FILE;
extern "C" {
    long strlen(string s);
    string? getenv(string name);
    void* malloc(long n);
    void free(void* p);
    double frexp(double x, int* e);
    FILE* fopen(string path, string mode);
    int fclose(FILE* f);
    void f(int* v);
    struct Named { array<char, 8> name; };
}

int main(int argc, char** argv) {
    println("{}", strlen("abc"));
    // expect: 3
    println("{}", getenv("CPLUS_NO_SUCH_VARIABLE") ?? "none");
    // expect: none
    void* p = malloc(1);
    free(p);
    int e = 0;
    println("{}", frexp(4, &e));
    // expect: 0.5
    FILE* f = fopen("", "r");
    println("{}", f == null);
    // expect: true
    Named s = {};
    println("[{}]", string(s.name));
    // expect: []
    println("{}", argc > 1 ? string(argv[1]) : "no arguments");
    // expect: no arguments
    return 0;
}
