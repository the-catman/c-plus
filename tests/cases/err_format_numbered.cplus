// Numbered placeholders name the values from {0}, and every value is used.
int main() {
    int x = 1;
    println("{2}", x, x);
    println("{0}");
    println("{1}", x, x);
    println("{0} {2}", x, x, x);
    println("{:{}}", x);
    println("%5d|%-8s|%05.2f|%+x|%#x|%.3s %%", x, "a", 2.5, x, x, "abcd");
    return 0;
}
// error: the format string uses {2}, but the values given are numbered from {0} to {1}
// error: write {0} for the first value after the format string, {1} for the next, and so on
