// What overloading does not reach yet: methods, constructors, and a template beside a function.
struct Point {
    int x = 0;
    int scale(int n) { return x * n; }
    int scale(double d) { return 0; }
};

class Box {
public:
    int size = 0;
    Box(int n) : size(n) {}
    Box(long n) : size(1) {}
};

template <typename T>
T twice(T x) { return x; }
int twice(int x) { return x; }

int main() {
    return 0;
}
// error: this compiler does not support overloaded methods yet
// error: rename one of them. Functions outside a type can share a name, when they take different parameters
// error: this compiler does not support more than one constructor yet
// error: this compiler does not support a template function and another function of the same name yet
