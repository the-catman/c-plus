struct Point { int x; int y; };
int main() {
    Point p;
    p.x = 1;
    println("{}", p);
    Point q;
    println("{}", q.y);
    Point r;
    println("{}", r);
    const Point fixed = {1, 2};
    fixed.x = 5;
    return 0;
}
// error: 'p' is used before all of its fields have values: 'p.y' has none yet
// error: 'q.y' is used before it is given a value
// error: 'r' is used before it is given a value
// error: e.g. `Point r = {};`
// error: 'fixed' is const, so its fields cannot be assigned to
