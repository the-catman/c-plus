// The forms that the spec's section on algorithms writes, each as it is written there.
struct Person {
    string name;
    int age;
};

bool byNumber(string a, string b) throws { return try stoi(a) < try stoi(b); }

template<typename T> bool goesBefore(function<bool(T, T)> less, T a, T b) { return less(a, b); }
template<typename T> bool passes(function<bool(T)> test, T x) { return test(x); }
template<typename A, typename T> A step(function<A(A, T)> f, A total, T x) { return f(total, x); }
template<typename T> bool tried(function<bool(T, T) throws> less, T a, T b) throws { return try less(a, b); }

int main() throws {
    vector<int> v = {5, 3, 8, 1};
    function<bool(int, int)> less = [](int a, int b) { return a > b; };
    function<bool(int)> test = [](int x) { return x > 2; };
    function<long(long, int)> f = [](long total, int x) { return total * 10 + x; };
    int x = 3;
    int start = 7;
    long init = 0;
    sort(v);
    println("{}", v);
    // expect: [1, 3, 5, 8]
    sort(v, less);
    println("{}", v);
    // expect: [8, 5, 3, 1]
    stable_sort(v);
    println("{}", binary_search(v, x));
    // expect: true
    stable_sort(v, less);
    println("{}", binary_search(v, x, less));
    // expect: true
    println("{} {} {} {}", min(v), max(v), min(v, less), max(v, less));
    // expect: 1 8 8 1
    println("{} {} {}", contains(v, x), count(v, x), index_of(v, x) ?? -1);
    // expect: true 1 2
    println("{} {} {}", any_of(v, test), all_of(v, test), none_of(v, test));
    // expect: true false false
    println("{} {}", count_if(v, test), index_if(v, test) ?? -1);
    // expect: 3 0
    println("{} {}", accumulate(v, init), accumulate(v, init, f));
    // expect: 17 8531
    println("{}", erase(v, x));
    // expect: 1
    println("{} {}", erase_if(v, test), v);
    // expect: 2 [1]
    vector<int> slots = vector<int>(3);
    iota(slots, start);
    reverse(slots);
    println("{}", slots);
    // expect: [9, 8, 7]
    sort(slots, [](int a, int b) { return a > b; });
    println("{}", slots);
    // expect: [9, 8, 7]
    println("{} {} {}", goesBefore(less, 2, 1), passes(test, 1), step(f, 1L, 2));
    // expect: true false 12
    println("{}", try tried(byNumber, "9", "10"));
    // expect: true
    vector<string> names = {"10", "9", "1"};
    try sort(names, byNumber);
    println("{}", names);
    // expect: ["1", "9", "10"]
    vector<double> prices = {1.5, 2.25};
    println("{}", accumulate(prices, 0.0));
    // expect: 3.75
    vector<Person> people = {{"Ada", 36}, {"Linus", 21}, {"Grace", 36}};
    sort(people, [](const auto& a, const auto& b) { return a.age < b.age; });
    println("{}", people[0].name);
    // expect: Linus
    println("{}", index_of(slots, min(slots)) ?? -1);
    // expect: 2
    iota(v, start);
    println("{}", v);
    // expect: [7]
    string word = "banana";
    sort(word);
    println("{}", word);
    // expect: aaabnn
    return 0;
}
