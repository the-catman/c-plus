int main() {
    int octal = 010;
    int a = 0o19;
    int b = 0b102;
    int c = 5u;
    int d = 5x;
    long e = checked(1 << 40);
    int f = 5L;
    int g = 0;
    checked(g <<= 32);
    return 0;
}
