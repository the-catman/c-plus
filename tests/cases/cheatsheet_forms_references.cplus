// The forms the cheat sheet gives for functions that return a reference.
struct Grid {
    vector<int> cells = {0, 0, 0};
    int& at(int i) { return cells[i]; }
};
int main() {
    Grid grid = Grid();
    int i = 1;
    grid.at(i) = 5;
    grid.at(i) += 1;
    println("{}", grid.cells);  // expect: [0, 6, 0]
    return 0;
}
class Account {
public:
    long balance = 0;
    Account() {}
};
class Bank {
public:
    vector<Account> accounts = {Account()};
    Bank() {}
    Account& find(int x) { return accounts[x]; }
};
int bound() {
    Grid grid = Grid();
    int i = 2;
    auto& e = grid.at(i);
    e = 3;
    Bank bank = Bank();
    int x = 0;
    auto& a = bank.find(x);
    a.balance += 1;
    return e + int(bank.accounts[0].balance);
}
int counted() {
    hashmap<string, int> m = {{"a", 1}};
    for (auto& e : m) e.second += 1;
    return m["a"];
}
