// A code that is not from 0 to 255 has no char, so converting it stops the program.
int main() {
    int n = 255;
    println("{}", int(char(n)));
    n++;
    char c = char(n);
    println("{}", c);
    return 0;
}
// expect: 255
// trap: char(x) was given 256, which does not fit in a char (from 0 to 255)
// trap: trap_char_cast.cplus:6:14
