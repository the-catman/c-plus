// What C structs often hold that C+ cannot write yet, and C's spellings of integers. A
// wrong guess at the type of a field would put the fields after it in the wrong places.
extern "C" {
    struct Header {
        short port;
    };
    struct Other {
        uint16_t port;
    };
    struct Third {
        unsigned short port;
    };
    struct Bytes {
        uint8_t tag;
    };
    struct Sized {
        unsigned int count;
        signed char letter;
    };
    struct Names {
        char name[64];
    };
    typedef struct { int quot; } div_t;
    struct timeval {
        time_t tv_sec;
        struct timeval* next;
        ssize_t size;
    };
    struct tm { int tm_sec; };
    void take(struct tm t);
}

int main() {
    struct tm t;
    class tm other;
    struct Local { int x; };
    return 0;
}
// error: this compiler does not support 16-bit integer types such as 'short' yet
// error: a C struct with such a field can still be used through pointers, by declaring it by name: `extern "C" struct name;`
// error: this compiler does not support 16-bit integer types such as 'uint16_t' yet
