// Splitting, trimming and replacing as Python, JavaScript, Rust and Boost write them, and what the compiler says instead.
int main() {
    string s = " a,b ";
    vector<string> v = {"a"};
    vector<int> numbers = {1, 2};
    s.replace("a", "b");
    string a = ", ".join(v);
    string b = s.strip();
    string c = s.lstrip();
    string d = s.rstrip();
    string e = s.trimStart();
    string f = s.trimEnd();
    string g = s.replaceAll("a", "b");
    auto h = s.split(",", 2);
    auto i = s.split();
    string j = numbers.join(",");
    string k = v.join();
    string l = s.trim(1);
    auto m = split(s, ",");
    auto n = trim(s);
    auto o = join(v, ", ");
    auto p = replace_all(s, "a", "b");
    auto q = strip(s);
    s.insert(5, ',');
    s.append('x');
    s.erase("a");
    s.insert(0);
    const string fixed = "x";
    fixed.append("y");
    long r = s.rfind();
    string t = s.splt(",");
    return 0;
}
