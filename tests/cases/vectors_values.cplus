// A vector is a value: a copy is independent of the original, as in C++. Copies share
// their elements until one of them changes (copy-on-write), which the results here
// must never show.
struct Bag {
    string label;
    vector<int> items;
    long count() const { return items.size(); }
    void add(int x) { items.push_back(x); }
};

class Shelf {
public:
    vector<int> items;
    vector<Bag> bags;
    void add(int x) { items.push_back(x); }
    long first() const { return items[0]; }
};

struct Tree {
    int value;
    vector<Tree> kids;
    int total() const {
        int sum = value;
        for (Tree k : kids) sum += k.total();
        return sum;
    }
};

void change(vector<int> v) {
    v[0] = 99;
    v.push_back(100);
}

vector<int> grow(vector<int> v) {
    v.push_back(v.back() + 1);
    return v;
}

int main() {
    vector<int> a = {1, 2, 3};
    vector<int> b = a;
    b[0] = 10;
    a.push_back(4);
    println("{} {}", a, b);
    // expect: [1, 2, 3, 4] [10, 2, 3]

    // Passing a vector gives the function its own copy.
    change(a);
    println("{}", a);
    // expect: [1, 2, 3, 4]
    vector<int> c = grow(grow(a));
    println("{} {}", a, c);
    // expect: [1, 2, 3, 4] [1, 2, 3, 4, 5, 6]

    // Assigning replaces the whole vector.
    b = a;
    a.pop_back();
    a = a;
    println("{} {}", a, b);
    // expect: [1, 2, 3] [1, 2, 3, 4]
    b = {};
    println("{}", b);
    // expect: []

    // Inside a copy of a vector of vectors, changing an inner vector leaves the
    // original alone.
    vector<vector<int>> grid = {{1}, {2}};
    vector<vector<int>> copy = grid;
    copy[0].push_back(5);
    copy[1][0] = 7;
    println("{} {}", grid, copy);
    // expect: [[1], [2]] [[1, 5], [7]]

    // Vectors in struct fields are copied with the struct.
    Bag x = {"x", {1}};
    Bag y = x;
    y.add(2);
    y.items[0] = 9;
    println("{} {} {}", x, y, y.count());
    // expect: {label: "x", items: [1]} {label: "x", items: [9, 2]} 2
    vector<Bag> bags = {x, y};
    bags[0].items.push_back(3);
    bags[1].add(4);
    println("{} {}", bags, x);
    // expect: [{label: "x", items: [1, 3]}, {label: "x", items: [9, 2, 4]}] {label: "x", items: [1]}

    // A class object holds its vector; references to the object share it.
    Shelf s = Shelf();
    Shelf t = s;
    s.add(1);
    t.items.push_back(2);
    s.bags.push_back(x);
    t.bags[0].items[0] = 5;
    println("{} {} {}", t.items, s.first(), s.bags);
    // expect: [1, 2] 1 [{label: "x", items: [5]}]
    vector<Shelf> shelves = {s, Shelf()};
    shelves[0].items.push_back(3);
    shelves[1].add(8);
    println("{} {}", s.items, shelves[1].items);
    // expect: [1, 2, 3] [8]

    // A struct can hold a vector of itself.
    Tree tree = {1, {{2, {}}, {3, {{4, {}}}}}};
    tree.kids[0].kids.push_back({5, {}});
    println("{} {}", tree.total(), tree.kids[1]);
    // expect: 15 {value: 3, kids: [{value: 4, kids: []}]}

    // The loop goes over the vector as it was when the loop started, so changing
    // the vector inside the loop is safe.
    vector<int> nums = {1, 2, 3};
    for (int n : nums) {
        nums.push_back(n * 10);
        nums[0] = 0;
    }
    println("{}", nums);
    // expect: [0, 2, 3, 10, 20, 30]
    for (auto n : nums) {
        if (n == 2) nums.clear();
        print("{} ", n);
    }
    println("{}", nums);
    // expect: 0 2 3 10 20 30 []

    // `?:` picks a whole vector.
    bool small = a.size() < 5;
    vector<int> picked = small ? a : vector<int>{};
    picked.push_back(0);
    println("{} {}", picked, a);
    // expect: [1, 2, 3, 0] [1, 2, 3]
    return 0;
}
