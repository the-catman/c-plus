// A module that uses sort gets it as the main file does, and a function of the program named like one of them takes its place.
import tools;

long count(vector<int> v, int x) { return 100; }

int main() {
    vector<int> v = {3, 1, 2};
    println("{} {}", tools::sorted(v), tools::middle(v));
    // expect: [1, 2, 3] 2
    println("{} {}", count(v, 1), count_if(v, [](int x) { return x > 1; }));
    // expect: 100 2
    return 0;
}
