class Node { public: int n = 0; };
class Other { public: int n = 0; };
void takesPlain(Node n) {}
void takesLocal(local<Node> n) {}
int main() {
    Node plain = Node();
    local<Node> a = plain;
    local<Node> b = local<Node>();
    Node c = b;
    takesPlain(b);
    takesLocal(plain);
    weak<Node> w = b;
    local<Node> d = null;
    local<Other> e = b;
    Node? f = b;
    return 0;
}
