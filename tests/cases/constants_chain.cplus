const long C21 = C20 + C20;
const long C22 = C21 + C21;
const long C23 = C22 + C22;
const long C24 = C23 + C23;
const long C25 = C24 + C24;
const long C26 = C25 + C25;
const long C27 = C26 + C26;
const long C28 = C27 + C27;
const long C29 = C28 + C28;
