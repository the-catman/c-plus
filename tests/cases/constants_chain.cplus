const string S0 = "a";
const string S1 = S0 + S0;
const string S2 = S1 + S1;
const string S3 = S2 + S2;
const string S4 = S3 + S3;
const string S5 = S4 + S4;
const string S6 = S5 + S5;
const string S7 = S6 + S6;
const string S8 = S7 + S7;
const string S9 = S8 + S8;
const string S10 = S9 + S9;

int main() {
    println("{}", C30);
    println("{}", D30);
    println("{}", S10.size());
    constexpr long both = C30 + D30;
    println("{}", both);
    return 0;
}
