// What an error advises depends on what it found. These are the branches that no other test reaches.
#define LIMIT 10
// error: Use a `const` variable or a function instead of #define
class Speaker {
public:
    void speak() {}
};
void pointers() {
    int n = 1;
    println("{}", n->x);
    // error: only a pointer can be followed with '->'
    int* p = &n;
    long big = 1;
    long* q = &big;
    println("{}", p == q);
    // error: pointers to different types cannot be compared; convert one first
    println("{}", p == 1);
    // error: a pointer is compared with another pointer to the same type, or with null
    println("{}", true & false);
    // error: use '&&' for logic
    Speaker().speek();
    // error: did you mean 'speak'?
}
int main() { return 0; }
