// What an error advises depends on what it found. These are the branches that no other test reaches.
#define LIMIT 10
// error: Use a `const` variable or a function instead of #define
class Speaker {
public:
    void speak() {}
};
void pointers() {
    int n = 1;
    println("{}", n->x);
    // error: remove `->x`: 'n' is a 'int', which has no fields
    int* p = &n;
    long big = 1;
    long* q = &big;
    println("{}", p == q);
    // error: pointers to different types cannot be compared; convert both first, e.g. `(void*)p == (void*)q`
    println("{}", p == 1);
    // error: write `*p == ...` to compare the value it points to
    println("{}", true & false);
    // error: use '&&' for logic
    Speaker().speek();
    // error: did you mean 'speak'?
}
int main() { return 0; }
