// An alias of a C++ type is given in C+ only for what C+ has, checked against its rules; anything else gets the help of the type itself.
class Node { };
struct Pt { int x = 0; };
using X1 = const std::set<int>;
// error: use a `vector<T>` or a `hashmap<K, V>` for now: `cplus explain hashmap` says what they do
using X2 = set<int>;
// error: use a `hashmap<T, bool>`, whose keys are the set, with `m.contains(x)`
using X4 = std::optional<std::weak_ptr<Node>>;
// error: write `using X4 = weak<Node>;`
using X5 = std::map<std::unique_ptr<Node>, int>;
// error: write `hashmap<K, V>`, used like std::unordered_map
using X6 = std::array<int>;
// error: built-ins need no prefix: write `array` instead of `std::array`
using X8 = std::size_t;
// error: write `using X8 = long;`
using Y1 = std::array<int, 3>;
// error: write `using Y1 = array<int, 3>;`
using Y2 = std::optional<Node>;
// error: write `using Y2 = Node?;`
using Y3 = std::map<std::string, std::vector<Pt>>;
// error: write `using Y3 = hashmap<string, vector<Pt>>;`
void f(Pt* p) {
    int a = (*p)->x;
    // error: fields and methods are reached with '.': write `(*p).x`
}
int main() { return 0; }
