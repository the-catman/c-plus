// An enumerator's value is an integer constant that fits the enum.
int f() { return 1; }

enum class Unknown { A = f() };
enum class Fraction { A = 1.5 };
enum class Text { A = "a" };
enum class Truth { A = true };
enum class TooBig { A = 3000000000 };
enum class Last { A = 2147483647, B };
enum class LongLast : long { A = 9223372036854775807, B };
enum class FromOther { A, B = A + 1 };
enum class Itself { A = int(Itself::A) };
enum class Overflow { A = checked(2147483647 + 1) };
enum class Divided { A = 1 / 0 };

int main() { return 0; }
