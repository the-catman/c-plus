// What is allowed through a pointer: reading through any, and `[ ]` through one that can change it.
int main() {
    hashmap<string, int> m = {{"a", 1}};
    hashmap<string, int>* p = &m;
    (*p)["b"] = 2;
    println("{}", (*p)["c"]);
    // expect: 0
    const hashmap<string, int>* q = &m;
    println("{} {} {}", q->size(), q->at("a"), q->get("nope") ?? -1);
    // expect: 3 1 -1
    return 0;
}
