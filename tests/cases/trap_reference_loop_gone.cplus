// `for (auto& x : v)` finds v[i] at each use of x, so once v is too short for it, using x stops the program.
int main() {
    vector<int> v = {1, 2, 3};
    for (auto& x : v) {
        v.pop_back();
        x += 1;
    }
    return 0;
}
// trap: 'x' refers to the element at index 1 of a vector that now has 1 element, so it is gone
