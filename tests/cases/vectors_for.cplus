// Range-based for loops, and indexes whose evaluation runs code.
struct Point {
    int x;
    int y;
};

class Log {
public:
    vector<int> entries;
    int add(int x) {
        entries.push_back(x);
        return 0;
    }
};

int firstOver(vector<int> v, int limit) {
    for (int x : v)
        if (x > limit) return x;
    return -1;
}

int main() {
    vector<int> v = {1, 2, 3, 4, 5, 6};
    for (int x : v) print("{},", x);
    println();
    // expect: 1,2,3,4,5,6,

    // break, continue and return leave the loop early.
    for (auto x : v) {
        if (x % 2 == 0) continue;
        if (x > 4) break;
        print("{} ", x);
    }
    println("| {}", firstOver(v, 3));
    // expect: 1 3 | 4

    // An int element converts to a long loop variable, as in C++.
    long sum = 0;
    for (long x : v) sum += x * 1000000000L;
    println("{}", sum);
    // expect: 21000000000

    // The loop variable is a copy of the element.
    vector<Point> ps = {{1, 2}, {3, 4}};
    for (Point p : ps) p.x = 100;
    for (const auto p : ps) print("{};", p);
    println();
    // expect: {x: 1, y: 2};{x: 3, y: 4};

    // To change elements, loop over the indexes.
    for (long i = 0; i < ps.size(); i++) ps[i].y *= 10;
    println("{}", ps);
    // expect: [{x: 1, y: 20}, {x: 3, y: 40}]

    // Nested loops, and a loop over a temporary.
    vector<vector<int>> grid = {{1, 2}, {3}, {}};
    for (auto row : grid) {
        print("[");
        for (int x : row) print(" {}", x);
        print(" ]");
    }
    println();
    // expect: [ 1 2 ][ 3 ][ ]
    for (string s : vector<string>{"a", "b"}) print("{}", s);
    println();
    // expect: ab

    // An index is evaluated before the vector is read, so it may change the vector.
    Log log = Log();
    log.entries = {10, 20};
    log.entries[log.add(30)] = 1;
    println("{}", log.entries);
    // expect: [1, 20, 30]
    vector<vector<int>> rows = {{0, 0}};
    int i = 0;
    rows[i][i++] = 5;
    println("{} {}", rows, i);
    // expect: [[5, 0]] 1
    return 0;
}
