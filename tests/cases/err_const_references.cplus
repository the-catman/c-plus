struct Holder {
    int& x;
};
const int& LIMIT = 5;
const int A = 1, & B = A;
string&& make() { return ""; }
void bump(int& n) { n += 1; }
int moved(vector<int>&& v) { return 0; }
struct Grid {
    int cells = 0;
    int& at(int i) { return cells; }
};
