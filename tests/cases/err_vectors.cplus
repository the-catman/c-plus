class User {
public:
    string name;
    User(string n) : name(n) {}
};

struct Range {
    int low;
    int high;
    Range(int a, int b) : low(a), high(b) {}
};

struct Point {
    int x;
    void move() { x++; }
};

struct Bag {
    vector<int> items;
    int peek() const {
        items.push_back(1);
        items[0] = 2;
        return 0;
    }
};

vector<int> make() { return {}; }

int main() {
    vector<int> v = {1, "a"};
    vector<string> names = {"a"};
    v.push_back("x");
    println("{}", v[true]);
    println("{}", v[-1]);
    int n = 5;
    println("{}", n[0]);
    v.add(1);
    v.length();
    println("{}", v.size);
    if (v) println("yes");
    println("{}", v < v);
    println("{}", v == names);
    const vector<int> c = {1};
    c.push_back(2);
    c[0] = 5;
    make().push_back(1);
    for (int x : n) println("{}", x);
    for (int s : names) println("{}", s);
    auto users = vector<User>(3);
    auto ranges = vector<Range>(2);
    auto many = vector<int>(1, 2, 3);
    vector<int> d = {.x = 1};
    auto loose = {1, 2};
    int size = v.size();
    v.front() = 3;
    v.push_back();
    v.emplace_back(1);
    v.insert(1);
    const Bag bag = {};
    bag.items.push_back(1);
    const vector<Point> ps = {{1}};
    ps[0].move();
    string s = "ab";
    println("{}", s[-1]);
    return 0;
}
