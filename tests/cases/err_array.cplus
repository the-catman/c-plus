// Mistakes with arrays.
extern "C" struct FILE;
extern "C" {
    void takesArray(array<int, 3> a);
    array<int, 3> givesArray();
    void takesPointer(int* p);
    struct CBad { array<string, 2> names; };
    struct CEmpty { array<int, 0> nothing; };
}

class User {
public:
    string name = "a";
};

class Box {
public:
    array<int, 2> values;
};

struct NeedsArgs {
    int x;
    NeedsArgs(int v) : x(v) {}
};

struct Users {
    array<User, 2> users;
};

struct Holds {
    array<Holds, 2> more;
};

struct TooBig {
    array<char, 2000000000> a;
    array<char, 2000000000> b;
};

array<int, 2> makeTwo() { return {1, 2}; }
Box makeBox() { return Box(); }

int main() {
    array<int, 3> a = {1, 2, 3};
    array<int, 2> two = {1, 2, 3};
    array<int, 2> named = {.x = 1};
    array<User, 2> shortList = {User()};
    array<NeedsArgs, 2> shortArgs = {};
    array<int, 3> wrong = {1, "two", 3};
    array<int, 4> otherSize = a;
    array<long, 3> otherElem = a;
    int plain = {1};

    // Methods.
    a.push_back(1);
    a.at(0);
    a.length();
    a.begin();
    a.fil(0);
    a.frobnicate();
    a.size(1);
    a.fill();
    a.fill("x");
    long noCall = a.size;
    long noCall2 = a.length;
    int field = a.x;
    makeTwo().fill(1);
    const array<int, 3> fixed = {1, 2, 3};
    fixed.fill(1);
    fixed[0] = 1;
    fixed = a;
    makeTwo()[0] = 1;

    // Indexes.
    int i1 = a[3];
    int i2 = a[-1];
    int i3 = a[1.5];
    int i4 = a['x'];
    array<int, 0> none;
    int i5 = none[0];

    return 0;
}
