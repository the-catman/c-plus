// Mistakes with pointers, and the C++ habits that do not carry over.
struct Point {
    int x = 0;
    void move(int dx) { x += dx; }
    Point* self() { return &this; }
};
class User {
public:
    string name = "a";
};
Point makePoint() { return {}; }

int main() {
    int n = 1;
    int* p = &n;
    char* cp = null;
    void* v = p;
    User u = User();
    Point pt;
    Point* pp = &pt;
    const Point* cpp = &pt;
    vector<int> vec = {1};
    string s = "abc";

    println("{}", *n);
    println("{}", u->name);
    println("{}", pp.x);
    pp.move(1);
    println("{}", *v);
    int* zero = 0;
    if (p == 0) println("zero");
    char* c2 = p;
    int* w = v;
    const int* ro = &n;
    int* rw = ro;
    *ro = 5;
    const int k = 5;
    int* pk = &k;
    int m;
    int* pm = &m;
    int* unset;
    int* copy = unset;
    int* t1 = &5;
    int* t2 = &vec[0];
    char* t3 = &s[0];
    int* t4 = &makePoint().x;
    auto t5 = p * 2;
    auto t6 = p + 1.5;
    auto t7 = p - cp;
    bool b1 = p < null;
    p *= 2;
    bool flag = p;
    long addr = (long)p;
    int* fromInt = (int*)n;
    char* m2 = (char*)ro;
    println("{}", cp);
    string t8 = cp;
    string t9 = string(p);
    int z = p;
    int* pz = n;
    auto t10 = p ?? p;
    auto t11 = pp?.x;
    cpp->move(1);
    auto t12 = sizeof(void);
    v++;
    auto t13 = p[1.5];
    auto t14 = -p;
    return 0;
}
