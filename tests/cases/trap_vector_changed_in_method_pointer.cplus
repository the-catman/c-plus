// The same through a pointer to the vector, and for a vector lying inside another one.
struct C {
    int n = 0;
    void touch(vector<vector<C>>* rows) {
        (*rows)[1].push_back(C{});
        n += 1;
    }
};

int main() {
    vector<vector<C>> rows = {{C{}}, {}};
    rows[0][0].touch(&rows);
    println("{}", rows);
    return 0;
}
