// An enumerator is named with its enum, and nothing converts to or from an enum by itself.
enum class Color { Red, Green, Blue };
enum class Shape { Circle, Square };
enum class Level { Low = 1, High = 2 };

struct Row {
    Level level;
};

void takesInt(int n) {}

template<typename T> T fresh() { return T(); }

int main() {
    Color named = RED;
    Color bare = Red;
    auto type = Color;
    Color purple = Color::Purple;
    Color greem = Color::Greem;
    Color fromInt = 1;
    int toInt = Color::Red;
    long toLong = Color::Blue;
    string toText = Color::Red;
    bool toBool = Color::Red;
    Color fromShape = Shape::Circle;
    Color fromLevel = Level::Low;
    takesInt(Color::Green);
    Color c = Color::Green;
    if (c) println("yes");
    while (!c) {}
    Color sum = c + 1;
    Color both = c | Color::Red;
    int shifted = c << 1;
    c++;
    --c;
    int negative = -c;
    println("{}", c == 1);
    println("{}", c < 2.5);
    println("{}", c == "Green");
    println("{}", c == Shape::Square);
    println("{}", c < Shape::Square);
    string text = "is " + c;
    string again = to_string(c);
    double d = double(c);
    bool b = bool(c);
    char letter = char(c);
    Shape s = Shape(c);
    Color fromText = Color("Red");
    Color fromDouble = Color(1.5);
    int? maybe = 1;
    Color fromOptional = Color(maybe);
    Color seven = Color(7);
    Color minus = static_cast<Color>(-1);
    auto levels = vector<Level>(3);
    Row row = {};
    Level made = fresh<Level>();
    return 0;
}

void written() {
    Color dotted = Color.Red;
    Color listed = Color{};
    Color empty = Color();
    Color two = Color(1, 2);
    Color number = Color::2;
    Level zero = Level();
}
