// Operators that C+ cannot overload, or not yet, and C++'s ways of writing them that C+ reads otherwise.
struct A { int x = 0; A operator+=(const A& o) const { return o; } };
struct B { int x = 0; B operator++() const { return this; } };
struct C { int x = 0; int operator()(int k) const { return k; } };
struct D { int x = 0; int operator->() const { return x; } };
struct E { int x = 0; bool operator&&(const E& o) const { return true; } };
struct F { int x = 0; bool operator!() const { return false; } };
struct G { int x = 0; void operator delete(int p) {} };
struct H { int x = 0; operator bool() const { return x != 0; } };
struct I { int x = 0; operator int() const { return x; } };
struct J { int x = 0; explicit operator int() const { return x; } };
struct K { int x = 0; friend K operator*(int k, K v) { return v; } };
struct L { int x = 0; operator+(const L& o) const { return o; } };
struct M { int x = 0; bool operator<(const M& o) const = default; };
class N { public: int x = 0; bool operator==(const N&) const = default; };
struct O { int x = 0; bool operator==(int k) const = default; };
struct P { int x = 0; };
ostream& operator<<(ostream& os, const P& p) { return os; }
template<typename T> T operator+(T a, T b) { return a; }
struct Q { int x = 0; int operator.() const { return x; } };
struct S { int x = 0; S operator""(int k) const { return this; } };
istream& operator>>(istream& in, P& p) { return in; }
int main() {
    int operator = 1;
    return 0;
}
