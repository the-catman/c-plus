// Functions may be used before they are defined.
int main() {
    println("{}", factorial(10));       // expect: 3628800
    println("{}", fib(20));             // expect: 6765
    greet("C+");                        // expect: hello, C+
    println("{}", widen(7));            // expect: 7
    println("{}", isEven(10));          // expect: true
    return 0;
}

long factorial(int n) {
    long result = 1;
    for (int i = 2; i <= n; i++) result *= i;
    return result;
}

int fib(int n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

void greet(string who) {
    println("hello, {}", who);
}

long widen(long x) { return x; }

bool isEven(int n) { return n % 2 == 0; }
