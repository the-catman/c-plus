extern int f(int x);
extern "C++" int g();
extern "C" size_t length(string s);
extern "C" long strlen(const char* s);
extern "C" char* strdup(string s);
extern "C" int printf(string format, ...);
extern "C" void* malloc(long size);
extern "C" int errno;
extern "C" int square(int n) { return n * n; }
extern "C" unsigned sleep(unsigned seconds);
extern "C" {
    extern "C" int abs(int);
    static int helper();
    int sum(int values[], int count);
    uint64_t hash(string s);
}

int main() {
    extern "C" int rand();
    return 0;
}
