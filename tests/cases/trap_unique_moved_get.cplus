class Node {
public:
    int n = 1;
};
struct Holder {
    unique<Node> held;
};
int main() {
    Holder h = {unique<Node>()};
    unique<Node> taken = move(h.held);
    println("{}", taken.n);
    Node lent = h.held.get();
    return 0;
}
