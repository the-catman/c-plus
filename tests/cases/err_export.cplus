// `export` goes before one declaration at the top of a file. In the main file it does nothing, and it is allowed.
export module app;
export export int a() { return 1; }
export static int b() { return 2; }
export { int c() { return 3; } }
export import json;
export extern "C" int abs(int n);
module app;
static int d() { return 4; }

export int main() { return 0; }

export
