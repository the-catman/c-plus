// What a function that returns `T&` cannot return, and where one cannot be used yet, or ever.
int& local() {
    int x = 1;
    return x;
}
int& byValue(int x) { return x; }
int& made(int& x) { return x + 1; }
long& other(int& x) { return x; }
int& element(vector<int> v) { return v[0]; }
struct Counter {
    int n = 0;
    int& peek() const { return n; }
};
async int& later() {
    await delay(1);
    return 1;
}
class Base {
public:
    int n = 1;
    Base() {}
    virtual int value() { return n; }
    virtual int& slot() { return n; }
};
class Derived : public Base {
public:
    Derived() {}
    int& value() override { return n; }
    int slot() override { return n; }
};
struct Box {
    vector<int> items = {1};
    int& operator[](long i) { return items[i]; }
};
struct Fixed {
    vector<int> items = {1};
    int& operator[](long i) const { return items[i]; }
};
int peek(const Box& b) { return b[0]; }
vector<int> g = {1, 2};
int& first() { return g[0]; }
class Account {
public:
    long balance = 0;
    Account() {}
};
class Bank {
public:
    vector<Account> accounts;
    Bank() {}
    Account& find(int i) { return accounts[i]; }
};
void adopt(Account& a) {}
int main() {
    auto t = spawn first();
    t.wait();
    Bank bank = Bank();
    auto& acct = bank.find(0);
    auto& alias = acct;
    acct = Account();
    alias = Account();
    adopt(acct);
    bank.find(0) = Account();
    return 0;
}
// error: 'local' returns a reference to its local variable 'x', which is gone when 'local' returns
// error: return a field, an element, a `int&` parameter or a variable outside functions, or make the return type `int`, which gives a copy
// error: 'byValue' returns a reference to its parameter 'x', which is a copy that is gone when 'byValue' returns
// error: 'made' returns a reference, which refers to a place, but this is a value
// error: 'other' returns a `long&`, but this is 'int'
// error: 'element' returns a reference to its parameter 'v', which is a copy that is gone when 'element' returns
// error: 'n' cannot be returned as a reference inside const method 'peek'
// error: an async function cannot return a reference, as it returns after its caller has moved on
// error: 'value' must have the same parameters, return type, `const` and `throws` as the method it replaces
// error: the method in 'Base' is `int value()`
// error: the method in 'Base' is `int& slot()`
// error: the elements of 'items' cannot be returned as a reference inside const method 'operator[]'
// error: the `operator[]` of 'Box' may change 'b', which is const, as it returns a reference, `int&`
// error: write one that only reads, for what is const: `int operator[](long i) const { ... }`, beside it
// error: `spawn` cannot run 'first', which returns a reference, `int&`, to a place that this thread uses
// error: give the thread a copy of the value at the place: `auto value = first();`, then `spawn [=] { ... }()` with it, or spawn a function that returns `int`
// error: 'acct' refers to the object that 'find' returned, not to the variable or element that holds it, so it cannot be assigned to
// error: `Account` is a class, so `Account& find` returns the object itself. To change the object, set its fields or call its methods. To put another object in its place, assign to the element or field that holds it. For a name that can later refer to another object, declare it `Account acct = bank.find(0);`
// error: 'alias' refers to the object that 'find' returned, not to the variable or element that holds it, so it cannot be assigned to
// error: parameter 'a' of 'adopt' can change what it refers to, so it needs a variable, a field or an element of an array, but 'acct' refers to an object that a call returned
// error: declare it `Account acct = ...;` and give it that, or make the parameter `Account`, which can still change the object's fields
// error: 'find' returns the object itself, not the variable or element that holds it, so it cannot be assigned to
