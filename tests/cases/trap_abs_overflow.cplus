// The smallest int has no positive counterpart, so abs() of it wraps around to itself, as
// negating it does. In a function marked [[checked]], that stops the program.
[[checked]] int positive(int n) { return abs(n); }
int main() {
    int smallest = -2147483647 - 1;
    println("{}", abs(smallest));
    println("{}", positive(smallest + 1));
    println("{}", positive(smallest));
    return 0;
}
// expect: -2147483648
// expect: 2147483647
// trap: integer overflow: the result of 'abs' does not fit in 'int'
// trap: trap_abs_overflow.cplus:3:42
