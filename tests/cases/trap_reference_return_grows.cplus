// The place a `T&` function returns lasts until the statement ends: the vector it lies in grew before then, so what was
// written through it would be lost, and the program stops.
vector<int> g = {1, 2};
int& first() { return g[0]; }
void set(int& e, int n) { e = n; }
int grow() {
    g.push_back(3);
    return 9;
}
int main() {
    first() = grow();  // `grow()` runs first, as the right side of `=` does
    println("{}", g);  // expect: [9, 2, 3]
    set(first(), grow());
    println("{}", g);
    return 0;
}
// trap: 'first' returned a place in a vector, string or hashmap that was grown, shrunk, copied, replaced or freed while the place was in use, which would lose what was written through it
// trap: trap_reference_return_grows.cplus:13:9
