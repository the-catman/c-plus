public:
    mutable int x = 0;
    // error: remove `mutable`, and take `const` off the method that changes it
};
class Explicit {
public:
    int x = 0;
    explicit Explicit(int a) : x(a) {}
    // error: remove it: a plain value never converts to a class by itself
};
