// `wait()` for a task whose function waits for its own task.
class Box {
public:
    Task<int>? other;
};

async int waitsFor(Box b) {
    await delay(1);
    if (auto t = b.other) return await t;
    return 0;
}

int main() {
    Box b = Box();
    auto t = waitsFor(b);
    b.other = t;
    return t.wait();
}
// trap: `wait()` waits for a task that nothing can finish any more
