// What a constant can and cannot be.
const int NO_VALUE;
int variable = 1;
int f() { return 1; }
const int FROM_CALL = f();
const int WRONG_TYPE = "text";
const int A = B;
const int B = A;
const int SELF = SELF + 1;
const auto AUTO_SELF = AUTO_SELF;
const int TWICE = 1;
const int TWICE = 2;
const vector<int> LIST = {1, 2};
const array<int, 2> ARRAY = {1, 2};
struct Point { int x = 0; };
const Point ORIGIN = {0};
const int* POINTER = null;
const int f = 3;
const int Point = 4;

int main() {
    TWICE = 3;
    TWICE++;
    int* p = &TWICE;
    return 0;
}
