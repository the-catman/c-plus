// What a constant can and cannot be.
const int NO_VALUE;
int f() { return 1; }
const int WRONG_TYPE = "text";
const int A = B;
const int B = A;
const int SELF = SELF + 1;
const auto AUTO_SELF = AUTO_SELF;
const int TWICE = 1;
const int TWICE = 2;
struct Point { int x = 0; };
const int* POINTER = null;
const int f = 3;
const int Point = 4;

int main() {
    TWICE = 3;
    TWICE++;
    int* p = &TWICE;
    return 0;
}
// error: the constant 'NO_VALUE' needs a value
// error: to initialize 'WRONG_TYPE'
// error: the value of 'A' depends on itself
// error: the value of 'SELF' depends on itself
// error: the value of 'AUTO_SELF' depends on itself
// error: 'TWICE' is already declared in this scope
// error: 'f' is already the name of a function
// error: 'Point' is already the name of a struct
// error: 'TWICE' is const and cannot be
// error: 'TWICE' is a constant, which has no address
