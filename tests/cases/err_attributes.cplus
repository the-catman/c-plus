// The one attribute C+ has is [[allow(new_delete)]]: before a function or a method, or
// alone at the top of the file.
[[nodiscard]] int f() { return 1; }
[[allow(unused)]] int g() { return 1; }
[[allow(new_delete)]] struct S {
    int x = 0;
};
[[allow(new_delete)]];
struct T {
    [[allow(new_delete)]] int* p = null;
    [[allow(new_delete)]] public:
    int y = 0;
};
int main() { return 0; }
// error: C+ has no attribute 'nodiscard'
// error: The one attribute C+ has is `[[allow(new_delete)]]`, which turns off the warning for new and delete
// error: 'unused' is not a warning that can be allowed
// error: [[allow(new_delete)]] is written before a function or a method, not a struct
// error: `[[allow(new_delete)]];` applies to the whole file, so it is written at the top, before the first declaration
// error: [[allow(new_delete)]] is written before a method, not a field
// error: for a field whose default value uses new, write `[[allow(new_delete)]];` at the top of the file
// error: [[allow(new_delete)]] is written before a method
