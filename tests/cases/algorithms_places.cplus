// What sort and the others change can be a variable, a field, an element, a value in a hashmap or a T& parameter.
class Box {
public:
    vector<int> items;
    Box() {}
    void tidy() { sort(items); }
    void tidyThis() { reverse(this.items); }
};
struct Grid {
    vector<vector<int>> rows;
    void sortRow(long i) { sort(rows[i], [](int a, int b) { return a > b; }); }
};
struct Deck {
    array<string, 3> cards;
};

void sortThrough(vector<int>& xs, int& calls) {
    sort(xs, [&](int a, int b) { calls++; return a < b; });
}

int main() {
    Box b = Box();
    b.items = {3, 1, 2};
    sort(b.items);
    println("{}", b.items);
    // expect: [1, 2, 3]
    b.tidyThis();
    b.tidy();
    erase(b.items, 2);
    println("{}", b.items);
    // expect: [1, 3]
    Grid g = {{{5, 4}, {9, 8, 7}, {1, 3, 2}}};
    sort(g.rows[0]);
    g.sortRow(2);
    iota(g.rows[1], 4);
    println("{}", g.rows);
    // expect: [[4, 5], [4, 5, 6], [3, 2, 1]]
    sort(g.rows, [](const vector<int>& a, const vector<int>& b) { return a.size() < b.size(); });
    println("{}", g.rows);
    // expect: [[4, 5], [4, 5, 6], [3, 2, 1]]
    hashmap<string, vector<int>> m;
    m["a"] = {2, 1};
    sort(m["a"]);
    erase_if(m["a"], [](int x) { return x > 1; });
    println("{}", m["a"]);
    // expect: [1]
    vector<int> xs = {4, 2, 3};
    int calls = 0;
    sortThrough(xs, calls);
    println("{} {}", xs, calls > 0);
    // expect: [2, 3, 4] true
    Deck d = {{"q", "k", "j"}};
    sort(d.cards);
    println("{}", d.cards);
    // expect: ["j", "k", "q"]
    vector<Box> boxes = {Box(), Box()};
    boxes[0].items = {1, 2, 3};
    sort(boxes, [](Box x, Box y) { return x.items.size() < y.items.size(); });
    sort(boxes[1].items, [](int a, int b) { return a > b; });
    println("{} {}", boxes[0].items, boxes[1].items);
    // expect: [] [3, 2, 1]
    // What a comparator shares can be the caller's variable, as the lambda only lives during the call.
    vector<string> order = {"b", "a"};
    int asked = 0;
    stable_sort(order, [&](string a, string b) { asked++; return a < b; });
    println("{} {}", order, asked > 0);
    // expect: ["a", "b"] true
    return 0;
}
