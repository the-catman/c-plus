// Aliases of the program's own types, and of tasks with `throws`, are fine as they are; numbers of other sizes, `const` elements,
// class pointers and wrong numbers of arguments are checked.
class Node { };
struct Pt { int x = 0; };
template <typename K, typename V>
class map { public: K k; V v; };
struct mutex { int x; };
template <typename T>
struct Stack { T x; };
using A1 = Task<long, throws>;
using A3 = vector<Task<int, throws>>;
using B1 = uint8_t;
// error: write `using B1 = char;`
using B3 = int16_t;
// error: write one of the types: int, long, double, float, bool, char, string, void, vector<T>, array<T, N>, hashmap<K, V>, T?, T*, or the structs and classes of the program
using C1 = map<int, int>;
using C2 = mutex;
using D1 = std::array<const int, 3>;
// error: built-ins need no prefix: write `array` instead of `std::array`
using E1 = Node*;
// error: write `using E1 = Node?;`
using F3 = Stack<int, int>;
// error: write e.g. `Stack<int>`
using F5 = std::vector<int>&;
// error: built-ins need no prefix: write `vector` instead of `std::vector`
int main() { return 0; }
