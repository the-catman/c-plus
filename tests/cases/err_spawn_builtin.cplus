int main() {
    auto a = spawn println("hi");
    vector<int> v;
    auto b = spawn v.size();
    auto c = spawn sqrt(2.0);
    return 0;
}
// error: `spawn` runs a function or method written in C+, and this is built in
// error: run it in a lambda: `spawn [=] { println("hi"); }()`
// error: run it in a lambda: `spawn [=] { return v.size(); }()`
// error: run it in a lambda: `spawn [=] { return sqrt(...); }()`
