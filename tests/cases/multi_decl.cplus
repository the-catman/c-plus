int main() {
    int a = 1, b = a + 1, c;
    c = a + b;
    println("{} {} {}", a, b, c);        // expect: 1 2 3
    const long lo = 10, hi = 20;
    println("{}", hi - lo);              // expect: 10
    for (int i = 0, j = 4; i < j; i++, j--) {
        println("{} {}", i, j);          // expect: 0 4
    }                                    // expect: 1 3
    return 0;
}
