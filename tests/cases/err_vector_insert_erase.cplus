// insert() and erase() take an index, as there are no iterators. What C++ writes with iterators gets the call to write.
vector<int> make() { return {1}; }

int main() {
    vector<int> v = {1, 2, 3};
    vector<int> other = {4};
    int i = 1;
    v.erase(v.begin() + i);
    v.erase(v.begin());
    v.insert(v.begin(), 0);
    v.insert(v.begin() + 2, 5);
    v.insert(v.end(), 7);
    v.erase(v.end() - 1);
    v.erase(v.end());
    v.erase(v.begin() + 1, v.begin() + 3);
    v.erase(0, 2);
    v.insert(v.end(), other.begin(), other.end());
    v.insert(v.cbegin(), 1);
    v.insert(0);
    v.insert(0, 1, 2);
    v.erase();
    v.insert(0, "x");
    v.erase("a");
    const vector<int> c = {1};
    c.erase(0);
    make().insert(0, 1);
    vector<int>? maybe = v;
    maybe?.erase(0);
    return 0;
}
// error: erase() takes the index of an element, as there are no iterators
// error: write `v.erase(i)`
// error: spec: docs/SPEC.md#vectors
// error: write `v.erase(0)`
// error: insert() takes the index of an element, as there are no iterators
// error: write `v.insert(0, 0)`, which puts it before the element at that index
// error: write `v.insert(2, 5)`
// error: write `v.push_back(7)`, which adds it at the end
// error: write `v.erase(v.size() - 1)`
// error: `v.end()` is past the last element. To remove the last one, write `v.pop_back()`
// error: erase them one at a time, from the last: `for (long k = 3 - 1; k >= 1; k--) v.erase(k);`
// error: this compiler does not support erase() of a range of a vector yet
// error: erase them one at a time, from the last: `for (long k = last - 1; k >= first; k--) v.erase(k);`
// error: insert them one at a time, each with `v.push_back(x)`
// error: write `v.insert(0, 1)`
// error: insert() takes 2 arguments, an index and a value, but 1 was given
// error: write `v.insert(i, value)`, which puts the value before the element at index i, or at the end when i is `v.size()`. For more than one, insert each
// error: insert() takes 2 arguments, an index and a value, but 3 were given
// error: erase() takes one argument, an index, but 0 were given
// error: write `v.erase(i)`, which removes the element at index i
// error: expected 'int' for insert() on 'vector<int>', but this is 'string'
// error: expected 'long' as the index for erase(), but this is 'string'
// error: 'c' is const and cannot be changed
// error: insert() changes the vector, so it must be called on a variable or a field
// error: erase() changes the vector, but '?.' works on a copy of it
