// Reading a number from a string as C and C++ do, and what the compiler says to write instead.
int main() throws {
    long a = stoll("1");
    double b = stold("1");
    long c = stoul("1");
    long d = stoull("1");
    int e = try stoi("ff", null, 16);
    double f = try stod("1.5", null);
    int g = atoi("1");
    long h = atol("1");
    double i = atof("1");
    string s = "5";
    int j = int(s);
    bool k = bool(s);
    int m = stoi(s);
    return 0;
}
void withStd() { double x = std::stod("1"); }
void withStdLong() { long x = std::stoll("1"); }
void withStdUnsigned() { long x = std::stoul("1"); }
void withStdC() { long x = std::strtol("1", null, 10); }
void withStdAtoi() { int x = std::atoi("1"); }
