// Running out of stack on the main thread, in a program that has threads, and so is built with --race too.
void other() {}

int down(int n) { return checked(down(n + 1) + 1); }  // checked, so -O keeps the calls

int main() {
    spawn other();
    println("before");
    println("{}", down(0));
    return 0;
}
// expect: before
// trap: ran out of stack
