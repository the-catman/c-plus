// int(c) of an enum held in a long keeps the lowest 32 bits of its number, as any cast to
// int does. In checked code a number that does not fit stops the program.
enum class Big : long { Small = 1, Huge = 5000000000 };

int main() {
    Big b = Big::Small;
    println("{}", int(b));
    // expect: 1
    b = Big::Huge;
    println("{}", long(b));
    // expect: 5000000000
    println("{}", int(b));
    // expect: 705032704
    println("{}", checked(int(b)));
    return 0;
}
// trap: int(x) was given 5000000000, which does not fit in an int
