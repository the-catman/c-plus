// All that can be wrong with JSON text says what and where. A debug build finds anything left behind by the
// values that were part way done when it went wrong.
import json;

struct Point {
    int x;
    int y = 0;
};
class Node {
public:
    string name;
    vector<Node> kids;
    Node? next;
};
struct Lists {
    vector<Point> points;
    array<int, 2> pair;
    hashmap<string, Point> map;
};

template<typename T> void bad(string text) {
    try {
        T value = try json::parse<T>(text);
        println("no error for {}: {}", text, value);
    } catch (json::Error e) {
        println("{}", e.what());
    } catch (Error e) {
        println("not a json::Error: {}", e.what());
    }
}

int main() {
    // Not JSON at all.
    bad<int>("");
    bad<int>("   ");
    bad<int>("abc");
    bad<int>("5 6");
    bad<Point>(R"({"x": 1} x)");
    bad<bool>("tru");
    bad<bool>("TRUE");

    // Numbers.
    bad<int>("+1");
    bad<int>("01");
    bad<double>("1.");
    bad<double>(".5");
    bad<double>("1e");
    bad<double>("-");
    bad<double>("NaN");
    bad<double>("Infinity");
    bad<double>("1e999");
    bad<float>("1e39");
    bad<int>("2147483648");
    bad<int>("-2147483649");
    bad<long>("9223372036854775808");
    bad<int>("1.5");
    bad<long>("1e30");

    // Strings.
    bad<string>("\"abc");
    bad<string>("\"a\nb\"");
    bad<string>("\"\\q\"");
    bad<string>("\"\\u12\"");
    bad<string>("\"\\uzzzz\"");
    bad<string>("\"\\ud83d\"");
    bad<string>("\"\\ud83d\\u0041\"");
    bad<string>("\"\\ude00\"");
    bad<string>("\"\\");
    string notText = "\"ab\"";
    notText[2] = char(200);
    bad<string>(notText);
    bad<char>("\"ab\"");
    bad<char>("\"\"");

    // Lists.
    bad<vector<int>>("[");
    bad<vector<int>>("[1");
    bad<vector<int>>("[1,");
    bad<vector<int>>("[1,]");
    bad<vector<int>>("[,1]");
    bad<vector<int>>("[1 2]");
    bad<vector<int>>("[1, \"a\"]");
    bad<array<int, 2>>("[1]");
    bad<array<int, 2>>("[1, 2, 3]");
    bad<array<int, 2>>("[1, ");

    // Objects.
    bad<Point>("{");
    bad<Point>(R"({"x"})");
    bad<Point>(R"({"x":)");
    bad<Point>(R"({"x": 1)");
    bad<Point>(R"({"x": 1,)");
    bad<Point>(R"({"x": 1,})");
    bad<Point>(R"({x: 1})");
    bad<Point>(R"({"x": 1 "y": 2})");
    bad<Point>("[1]");
    bad<Point>("{}");
    bad<Point>(R"({"y": 2})");
    bad<Point>("null");
    bad<hashmap<string, int>>(R"({"a" 1})");
    bad<hashmap<string, int>>(R"({"a": "b"})");
    bad<hashmap<string, int>>("{");
    bad<hashmap<string, int>>("[]");
    bad<hashmap<int, int>>(R"({"a": 1})");
    bad<hashmap<int, int>>(R"({"": 1})");
    bad<hashmap<int, int>>(R"({"99999999999": 1})");
    bad<hashmap<long, int>>(R"({" 1": 1})");

    // Wrong in something unknown, which is left out but must still be JSON.
    bad<Point>(R"({"x": 1, "other": [1, })");
    bad<Point>(R"({"x": 1, "other": {"a"}})");
    bad<Point>(R"({"x": 1, "other": tru})");
    bad<Point>(R"({"x": 1, "other": "abc})");

    // Where it is, as lines and as a path, with what was done so far released.
    bad<Lists>(R"({
  "points": [
    {"x": 1},
    {"x": "two"}
  ]
})");
    bad<Lists>(R"({"pair": [1, "x"]})");
    bad<Lists>(R"({"map": {"a": {"x": 1}, "b": {"y": 2}}})");
    bad<Node>(R"({"name": "a", "kids": [{"name": "b", "kids": [{"name": 5}]}]})");
    bad<Node>(R"({"name": "a", "next": {"name": "b", "next": {"kids": []}}})");
    bad<vector<Node>>(R"([{"name": "a"}, {"name": "b"}, {"name": 1}])");
    return 0;
}
