// char: one byte, from 0 to 255, as in C++. A char literal is written in single quotes;
// arithmetic works on the char's code, as an int.
struct Key {
    char letter;
    int code;
    char spare;
};

int main() {
    // Literals and escapes, the same as in strings.
    char a = 'a';
    char quote = '\'';
    char tab = '\t';
    char hex = '\x41';
    println("{} {} {} {}|{}|", a, quote, hex, '"', tab);
    // expect: a ' A "|	|

    // A char converts to its code by itself; the other way takes a cast.
    int code = a;
    long wide = 'z';
    double d = 'A';
    println("{} {} {} {} {}", code, wide, d, char(98), (char)99);
    // expect: 97 122 65 b c
    println("{} {} {}", static_cast<char>(100), char(65.9), int('\0'));
    // expect: d A 0

    // Arithmetic is on the codes, as int, as in C++.
    println("{} {} {} {}", a + 1, 'z' - a, a * 2, -a);
    // expect: 98 25 194 -97
    println("{} {} {}", char(a + 1), char('0' + 7), '7' - '0');
    // expect: b 7 7
    println("{} {} {}", a & 0x5F, char(a ^ 32), +a);
    // expect: 65 A 97

    // ++, --, += and -= step through the characters and keep a char.
    char c = 'a';
    c++;
    ++c;
    c += 2;
    c -= 1;
    println("{} {}", c, c--);
    // expect: d d
    for (char x = 'a'; x <= 'f'; x += 2) print("{}", x);
    println();
    // expect: ace

    // Comparisons order chars by their codes, from 0 to 255.
    char high = char(200);
    println("{} {} {} {}", 'a' < 'b', 'Z' < 'a', high > 'z', c == 'c');
    // expect: true true true true
    println("{} {} {}", a == 97, 'b' != a, max('q', 'k'));
    // expect: true true q

    // Character tests and conversions from <cctype>, for ASCII.
    println("{} {} {} {}", isdigit('7'), isalpha('7'), isalnum('_'), isspace('\n'));
    // expect: true false false true
    println("{} {} {} {}", isupper('Q'), islower('Q'), ispunct('!'), isxdigit('F'));
    // expect: true false true true
    println("{} {} {} {}", toupper('m'), tolower('M'), toupper('5'), tolower(high) == high);
    // expect: M m 5 true

    // In structs, vectors and optionals, a char prints in quotes.
    Key k = {'q', 7};
    vector<char> v = {'x', '\'', '\n', '\0', high};
    char? some = 'm';
    char? none;
    println("{}", k);
    // expect: {letter: 'q', code: 7, spare: '\0'}
    println("{} {} {} {}", v, some, none, none ?? '-');
    // expect: ['x', '\'', '\n', '\0', '\xc8'] m null -
    println("{} {}", k == Key{'q', 7}, v == vector<char>{'x'});
    // expect: true false
    println("{} {}", format("[{}]", a), true ? 'y' : 'n');
    // expect: [a] y
    auto mixed = false ? 'y' : 1;
    println("{}", mixed);
    // expect: 1
    return 0;
}
