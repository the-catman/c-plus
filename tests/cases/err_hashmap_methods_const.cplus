int main() {
    const hashmap<string, int> m = {{"a", 1}};
    println("{}", m.size());
    println("{}", m.at("a"));
    println("{}", m.get("a"));
    m.erase("a");
    return 0;
}
// error: cannot call 'erase' on const 'm', because it may change fields
