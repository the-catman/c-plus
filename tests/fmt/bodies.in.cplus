int main() {
    int x = 0;
    if (x > 0) x = 1;
    else if (x < 0) x = -1;
    else x = 2;
    if (x > 0)
    x = 3;
    else
    x = 4;
    while (x > 0) x--;
    for (int i = 0; i < 3; i++) if (i == 1) { x = i; break; }
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            x += i * j;
    do x++; while (x < 3);
    do
        x++;
    while (x < 5);
    if (x > 0) if (x > 1) x = 0;
    return x;
}
