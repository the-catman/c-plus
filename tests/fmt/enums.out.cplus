enum class Color { Red, Green, Blue };
enum class Big : long {
    Small = -5,
    Huge = 5000000000,  // a lot
    Max
};
enum class Mode {
    A = 1, B = 2,
    C = 1 << 3,
};
// A list on one line stays there.
enum class Two { First, Second, };

Color pick(Mode m) {
    Color c = Color(int(m) - 1);
    Color* p = &c;
    return *p == Color::Red ? (Color)1 : *p;
}

int main() {
    println("{} {}", pick(Mode::B), static_cast<Color>(0));
    return 0;
}
